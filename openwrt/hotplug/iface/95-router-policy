#!/bin/sh
[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifupdate" ] || exit 0
[ -n "$INTERFACE" ] || exit 0
[ "${#INTERFACE}" -le 64 ] || exit 0
case "$INTERFACE" in
	*[!A-Za-z0-9_.:-]*) exit 0 ;;
esac
/usr/lib/router-policy/openwrt/adapter.sh reconcile /etc/router-policy/config/default.json >/tmp/router-policy/hotplug-iface.log 2>&1 || true
