#!/bin/sh
[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifupdate" ] || exit 0
[ -n "$INTERFACE" ] || exit 0
[ "${#INTERFACE}" -le 64 ] || exit 0
case "$INTERFACE" in
	*[!A-Za-z0-9_.:-]*) exit 0 ;;
esac
helper="${ROUTER_POLICY_HOTPLUG_EVENT:-/usr/lib/router-policy/openwrt/hotplug-event}"
"$helper" interface "$ACTION" "$INTERFACE"
