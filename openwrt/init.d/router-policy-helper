#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

START=94
STOP=11
USE_PROCD=1

start_service() {
  env_file="${ROUTER_POLICY_HELPER_ENV:-/etc/router-policy/helper.env}"
  [ -f "$env_file" ] && [ ! -L "$env_file" ] || {
    logger -t router-policy-helper "disabled: explicit non-root peer_uid is required"
    return 0
  }
  peer_uid="$(sed -n 's/^peer_uid=//p' "$env_file" | head -n 1)"
  case "$peer_uid" in
    ''|0|*[!0-9]*)
      logger -t router-policy-helper "disabled: helper.env peer_uid is invalid"
      return 0
      ;;
  esac
  socket="$(sed -n 's/^socket=//p' "$env_file" | head -n 1)"
  [ -n "$socket" ] || socket=/var/run/router-policy/helper.sock
  [ "$socket" = /var/run/router-policy/helper.sock ] || {
    logger -t router-policy-helper "disabled: helper socket path is not allowlisted"
    return 0
  }
  run_dir="${ROUTER_POLICY_HELPER_RUN_DIR:-/var/run/router-policy}"
  [ "$run_dir" = /var/run/router-policy ] || [ -n "$ROUTER_POLICY_HELPER_RUN_DIR" ] || {
    logger -t router-policy-helper "disabled: helper runtime directory is not configured safely"
    return 0
  }
  mkdir -p "$run_dir"
  chmod 700 "$run_dir"
  procd_open_instance router-policy-helper
  procd_set_param env ROUTER_POLICY_HELPER_PEER_UID="$peer_uid"
  procd_set_param env ROUTER_POLICY_HELPER_SOCKET="$socket"
  procd_set_param env ROUTER_POLICY_ADAPTER_PATH=/usr/lib/router-policy/openwrt/adapter.sh
  procd_set_param env ROUTER_POLICY_CONFIG_PATH=/etc/router-policy/config/default.json
  procd_set_param env ROUTER_POLICY_INIT_DIR=/etc/init.d
  procd_set_param command /usr/bin/router-policy-helper
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

stop_service() {
  # Do not unlink an object we cannot prove is the helper's socket.  The
  # process owns its listener; a stale socket is checked and removed safely
  # by ServeUnix on the next start.
  return 0
}
