#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

START=95
STOP=10
USE_PROCD=1

start_service() {
  # ProbeRoute and route-assignment reconcile run in the daemon controller and
  # need only the generation/hash binding. Expose the dedicated binding, not
  # the controller-owned runtime directory that also contains locks and
  # rollback data.
  runtime_dir=/tmp/router-policy
  controller_binding_dir=/tmp/router-policy-controller
  controller_binding="$controller_binding_dir/active-transaction.env"
  [ -d "$runtime_dir" ] && [ ! -L "$runtime_dir" ] || return 1
  [ ! -L "$controller_binding_dir" ] || return 1
  mkdir -p "$controller_binding_dir" || return 1
  chown root:daemon "$controller_binding_dir" || return 1
  chmod 750 "$controller_binding_dir" || return 1
  # Upgrade compatibility: publish the existing generation binding once into
  # the dedicated path. Never move or delete the root-only source here.
  legacy_binding="$runtime_dir/active-transaction.env"
  if [ ! -e "$controller_binding" ] && [ -f "$legacy_binding" ] && [ ! -L "$legacy_binding" ]; then
    cp "$legacy_binding" "$controller_binding.tmp" || return 1
    chown root:daemon "$controller_binding.tmp" || return 1
    chmod 640 "$controller_binding.tmp" || return 1
    mv "$controller_binding.tmp" "$controller_binding" || return 1
  fi
  if [ -f "$controller_binding" ] && [ ! -L "$controller_binding" ]; then
    chown root:daemon "$controller_binding" || return 1
    chmod 640 "$controller_binding" || return 1
  fi
  listen_address=127.0.0.1:8787
  allow_lan_bind=0
  listener_config=/etc/router-policy/config/listener.conf
  if [ -f "$listener_config" ] && [ ! -L "$listener_config" ]; then
    configured_address="$(sed -n 's/^listen_address=//p' "$listener_config" | head -n 1)"
    [ -z "$configured_address" ] || listen_address="$configured_address"
    configured_lan_bind="$(sed -n 's/^allow_firewalled_bind=//p' "$listener_config" | head -n 1)"
    [ "$configured_lan_bind" = "1" ] && allow_lan_bind=1
  fi
  procd_open_instance
  # LAN exposure is an explicit operator opt-in.  The controller validates
  # that the address is a private, non-wildcard unicast address; the legacy
  # broad firewalled-bind override is never exported by this service.
  if [ "$allow_lan_bind" = "1" ]; then
    procd_set_param env ROUTER_POLICY_CONFIG=/etc/router-policy/config/default.json ROUTER_POLICY_ALLOW_LAN_BIND=1 ROUTER_POLICY_HELPER_SOCKET=/var/run/router-policy/helper.sock
  else
    procd_set_param env ROUTER_POLICY_CONFIG=/etc/router-policy/config/default.json ROUTER_POLICY_HELPER_SOCKET=/var/run/router-policy/helper.sock
  fi
  # The controller is deliberately unprivileged. All dataplane mutation goes
  # through the fixed root helper socket; procd is the lifecycle owner.
  procd_set_param user daemon
  procd_set_param group daemon
  procd_set_param command /usr/bin/router-policy run --listen "$listen_address"
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

reload_service() {
  /usr/bin/router-policy validate-config
}
