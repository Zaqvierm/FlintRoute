#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

START=95
STOP=10
USE_PROCD=1

start_service() {
  listen_address=127.0.0.1:8787
  listener_config=/etc/router-policy/config/listener.conf
  if [ -f "$listener_config" ] && [ ! -L "$listener_config" ]; then
    configured_address="$(sed -n 's/^listen_address=//p' "$listener_config" | head -n 1)"
    [ -z "$configured_address" ] || listen_address="$configured_address"
  fi
  procd_open_instance
  procd_set_param env ROUTER_POLICY_CONFIG=/etc/router-policy/config/default.json
  # The controller still runs as root in v1.  Never enable the legacy
  # firewalled-bind escape hatch: the privileged API must remain loopback-only
  # until the non-root controller/helper boundary is production-complete.
  procd_set_param command /usr/bin/router-policy run --listen "$listen_address"
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

reload_service() {
  /usr/bin/router-policy validate-config
}
